From dd089c8b8434855f29638800eb99a1e24e81ca72 Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Thu, 24 Sep 2026 23:05:28 +0800
Subject: [PATCH 1/2] Add scale-aware regression (SAR) reweighting for DFL-free
 box loss

YOLO26 removes DFL (reg_max=1) so box regression is a plain image-normalized
L1 whose gradient is scale-agnostic: a 1px error costs the same for a 4px and
a 64px object, even though it is far more damaging in IoU terms for the small
one. SAR multiplies the per-target L1 weight by (sar_s0 / size) ** sar_w,
capped at sar_cap and renormalized to mean 1, so sar_w=0 reproduces the
original loss exactly and inference cost is unchanged.
---
 ultralytics/cfg/__init__.py  |  3 +++
 ultralytics/cfg/default.yaml |  3 +++
 ultralytics/utils/loss.py    | 26 +++++++++++++++++++++++---
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/ultralytics/cfg/__init__.py b/ultralytics/cfg/__init__.py
index 461cc30ff..f89271844 100644
--- a/ultralytics/cfg/__init__.py
+++ b/ultralytics/cfg/__init__.py
@@ -205,6 +205,9 @@ CFG_FLOAT_KEYS = frozenset(
         "box",
         "cls",
         "dfl",
+        "sar_w",
+        "sar_s0",
+        "sar_cap",
         "pose",
         "kobj",
         "rle",
diff --git a/ultralytics/cfg/default.yaml b/ultralytics/cfg/default.yaml
index 1152226f9..017fcdf20 100644
--- a/ultralytics/cfg/default.yaml
+++ b/ultralytics/cfg/default.yaml
@@ -105,6 +105,9 @@ box: 7.5 # (float) box loss gain
 cls: 0.5 # (float) classification loss gain
 cls_pw: 0.0 # (float) class weights power for handling class imbalance (0.0=disable, 1.0=full inverse frequency)
 dfl: 1.5 # (float) box distance loss gain (DFL when reg_max > 1, L1 on DFL-free YOLO26)
+sar_w: 0.0 # (float) scale-aware regression strength for the DFL-free L1 term (0.0=off, 1.0=weight proportional to sar_s0/size)
+sar_s0: 16.0 # (float) reference object size in pixels for scale-aware regression, always >= 1
+sar_cap: 4.0 # (float) maximum up-weighting factor for small objects in scale-aware regression, always >= 1
 pose: 12.0 # (float) pose loss gain (pose tasks)
 kobj: 1.0 # (float) keypoint objectness loss gain (pose tasks)
 rle: 1.0 # (float) rle loss gain (pose tasks)
diff --git a/ultralytics/utils/loss.py b/ultralytics/utils/loss.py
index 262667a78..963a274d8 100644
--- a/ultralytics/utils/loss.py
+++ b/ultralytics/utils/loss.py
@@ -111,10 +111,24 @@ class DFLoss(nn.Module):
 class BboxLoss(nn.Module):
     """Criterion class for computing training losses for bounding boxes."""
 
-    def __init__(self, reg_max: int = 16):
-        """Initialize the BboxLoss module with regularization maximum and DFL settings."""
+    def __init__(self, reg_max: int = 16, sar_w: float = 0.0, sar_s0: float = 16.0, sar_cap: float = 4.0):
+        """Initialize the BboxLoss module with regularization maximum, DFL settings and scale-aware regression gains."""
         super().__init__()
         self.dfl_loss = DFLoss(reg_max) if reg_max > 1 else None
+        self.sar_w = sar_w  # scale-aware regression strength (0.0 disables, keeping the original L1)
+        self.sar_s0 = sar_s0  # reference object size in pixels
+        self.sar_cap = sar_cap  # maximum up-weighting factor for small objects
+
+    def scale_weight(self, target_bboxes: torch.Tensor) -> torch.Tensor:
+        """Return per-target regression weights that grow as objects shrink below sar_s0.
+
+        Weights are (sar_s0 / size) ** sar_w capped at sar_cap and renormalized to mean 1, so sar_w=0 or an all-one
+        weight vector leaves the original loss scale unchanged while only the distribution across scales changes.
+        """
+        wh = (target_bboxes[:, 2:] - target_bboxes[:, :2]).clamp(min=0)
+        size = (wh[:, 0] * wh[:, 1]).sqrt().clamp(min=1.0)
+        weight = (self.sar_s0 / size).clamp(max=self.sar_cap).pow(self.sar_w)
+        return weight / weight.mean().clamp(min=1e-6)
 
     def forward(
         self,
@@ -148,6 +162,7 @@ class BboxLoss(nn.Module):
             pred_dist = pred_dist * stride
             pred_dist[..., 0::2] /= imgsz[1]
             pred_dist[..., 1::2] /= imgsz[0]
+            weight = weight if self.sar_w == 0 else weight * self.scale_weight(target_bboxes[fg_mask])[:, None]
             loss_dfl = (
                 F.l1_loss(pred_dist[fg_mask], target_ltrb[fg_mask], reduction="none").mean(-1, keepdim=True) * weight
             )
@@ -370,7 +385,12 @@ class v8DetectionLoss:
             stride=self.stride.tolist(),
             topk2=tal_topk2,
         )
-        self.bbox_loss = BboxLoss(m.reg_max).to(device)
+        self.bbox_loss = BboxLoss(
+            m.reg_max,
+            sar_w=getattr(h, "sar_w", 0.0),
+            sar_s0=getattr(h, "sar_s0", 16.0),
+            sar_cap=getattr(h, "sar_cap", 4.0),
+        ).to(device)
         self.proj = torch.arange(m.reg_max, dtype=torch.float, device=device)
 
     def preprocess(self, targets: torch.Tensor, batch_size: int, scale_tensor: torch.Tensor) -> torch.Tensor:
