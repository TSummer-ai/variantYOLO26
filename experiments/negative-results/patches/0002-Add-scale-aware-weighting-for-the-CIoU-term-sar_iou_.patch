+        loss_iou = ((1.0 - iou) * iou_weight).sum() / target_scores_sum
 
         # DFL loss
         if self.dfl_loss:
@@ -162,7 +174,8 @@ class BboxLoss(nn.Module):
             pred_dist = pred_dist * stride
             pred_dist[..., 0::2] /= imgsz[1]
             pred_dist[..., 1::2] /= imgsz[0]
-            weight = weight if self.sar_w == 0 else weight * self.scale_weight(target_bboxes[fg_mask])[:, None]
+            if self.sar_w:
+                weight = weight * self.scale_weight(target_bboxes[fg_mask], self.sar_w)[:, None]
             loss_dfl = (
                 F.l1_loss(pred_dist[fg_mask], target_ltrb[fg_mask], reduction="none").mean(-1, keepdim=True) * weight
             )
@@ -390,6 +403,7 @@ class v8DetectionLoss:
             sar_w=getattr(h, "sar_w", 0.0),
             sar_s0=getattr(h, "sar_s0", 16.0),
             sar_cap=getattr(h, "sar_cap", 4.0),
+            sar_iou_w=getattr(h, "sar_iou_w", 0.0),
         ).to(device)
         self.proj = torch.arange(m.reg_max, dtype=torch.float, device=device)
 
