diff --git a/test_dhcd.py b/test_dhcd.py
new file mode 100644
index 000000000..e3d606667
--- /dev/null
+++ b/test_dhcd.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python
+"""DHCD 定向验证。
+
+验收标准：
+  ① 蒸馏项给 student 传梯度（student 分类分支梯度变大）
+  ② 蒸馏项**不**给 teacher 传梯度（teacher 梯度逐位不变）
+  ③ dhcd_w=0 时不产生额外日志项
+
+注意：Detect 里 one2one 头是 one2many 头的 deepcopy，**初始化时两个头的输出完全相同**，
+此时 BCE 的梯度恰好为 0（σ(s)==t）。所以必须先扰动 student 让两头分开，验证才有意义。
+
+用法: PYTHONPATH=/home/wang/DeepSeek/YOLO/wt-dhcd python test_dhcd.py
+"""
+
+import torch
+from ultralytics.nn.tasks import DetectionModel
+from ultralytics.utils import DEFAULT_CFG_DICT, IterableSimpleNamespace
+
+CFG = "ultralytics/cfg/models/26/yolo26.yaml"
+BATCH = {
+    "batch_idx": torch.tensor([0.0, 0.0, 1.0]),
+    "cls": torch.tensor([3.0, 7.0, 1.0]),
+    "bboxes": torch.tensor([[0.5, 0.5, 0.05, 0.05], [0.2, 0.3, 0.1, 0.2], [0.7, 0.6, 0.02, 0.03]]),
+}
+
+
+def grads(model):
+    """取四个关键分支的梯度快照。"""
+    head = model.model[-1]
+    return {
+        "teacher_cls": head.cv3[0][-1].weight.grad.detach().clone(),
+        "teacher_box": head.cv2[0][-1].weight.grad.detach().clone(),
+        "student_cls": head.one2one_cv3[0][-1].weight.grad.detach().clone(),
+        "student_box": head.one2one_cv2[0][-1].weight.grad.detach().clone(),
+    }
+
+
+def main():
+    torch.manual_seed(0)
+    model = DetectionModel(CFG, nc=10, verbose=False)
+    args = IterableSimpleNamespace(**DEFAULT_CFG_DICT)
+    args.dhcd_w = 0.0
+    model.args = args
+    criterion = model.init_criterion()
+    model.train()
+
+    head = model.model[-1]
+    with torch.no_grad():
+        # 抬高分类输出层偏置（否则初始概率过低、教师 mask 为空），并让 student 与 teacher 分岔
+        head.cv3[0][-1].bias.fill_(0.5)
+        head.one2one_cv3[0][-1].bias.fill_(-1.0)
+        head.one2one_cv3[0][-1].weight.add_(0.3 * torch.randn_like(head.one2one_cv3[0][-1].weight))
+
+    x = torch.rand(2, 3, 640, 640)  # 两次运行共用同一输入
+
+    criterion.dhcd_w = 0.0
+    model.zero_grad()
+    loss0, items0 = criterion(model(x), BATCH)
+    loss0.sum().backward()
+    g0 = grads(model)
+
+    criterion.dhcd_w = 1.0
+    model.zero_grad()
+    loss1, items1 = criterion(model(x), BATCH)
+    loss1.sum().backward()
+    g1 = grads(model)
+
+    print(f"dhcd_w=0: loss={float(loss0.sum()):.6f} items={sorted(items0)}")
+    print(f"dhcd_w=1: loss={float(loss1.sum()):.6f} items={sorted(items1)} dhcd_loss={float(items1['dhcd_loss']):.6f}")
+    print(f"loss 增量 = {float(loss1.sum() - loss0.sum()):.6f}  (应等于 dhcd_loss)")
+    print()
+    for k in ("teacher_cls", "teacher_box"):
+        print(f"{k:12s} 逐位一致? {torch.equal(g0[k], g1[k])}   (必须 True —— 蒸馏不回传 teacher)")
+    for k in ("student_cls", "student_box"):
+        print(f"{k:12s} 梯度变化 = {(g1[k] - g0[k]).abs().sum().item():.6e}   (student_cls 必须 > 0)")
+    assert torch.equal(g0["teacher_cls"], g1["teacher_cls"]), "teacher 分类分支被蒸馏影响了"
+    assert torch.equal(g0["teacher_box"], g1["teacher_box"]), "teacher 回归分支被蒸馏影响了"
+    assert (g1["student_cls"] - g0["student_cls"]).abs().sum() > 0, "student 分类分支没收到蒸馏梯度"
+    assert "dhcd_loss" not in items0 and "dhcd_loss" in items1, "日志项不符合预期"
+    print("\n全部验收标准通过 ✅")
+
+
+if __name__ == "__main__":
+    main()
