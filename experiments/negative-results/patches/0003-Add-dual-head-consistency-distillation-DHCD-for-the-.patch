@@ -105,6 +105,7 @@ box: 7.5 # (float) box loss gain
 cls: 0.5 # (float) classification loss gain
 cls_pw: 0.0 # (float) class weights power for handling class imbalance (0.0=disable, 1.0=full inverse frequency)
 dfl: 1.5 # (float) box distance loss gain (DFL when reg_max > 1, L1 on DFL-free YOLO26)
+dhcd_w: 0.0 # (float) dual-head consistency distillation weight: one-to-many teacher -> one-to-one student (0.0=off)
