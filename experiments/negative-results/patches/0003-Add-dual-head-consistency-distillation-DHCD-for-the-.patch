diff --git a/ultralytics/utils/loss.py b/ultralytics/utils/loss.py
index 262667a78..ecc26977f 100644
--- a/ultralytics/utils/loss.py
+++ b/ultralytics/utils/loss.py
@@ -1317,6 +1317,8 @@ class E2ELoss:
         self.o2m_copy = self.o2m
         # final gain
         self.final_o2m = 0.1
+        # dual-head consistency distillation: one-to-many teacher → one-to-one student
+        self.dhcd_w = getattr(self.one2one.hyp, "dhcd_w", 0.0)
 
     def __call__(self, preds: Any, batch: dict[str, torch.Tensor]) -> tuple[torch.Tensor, dict[str, torch.Tensor]]:
         """Calculate the sum of the loss for box, cls and dfl multiplied by batch size."""
@@ -1324,7 +1326,29 @@ class E2ELoss:
         one2many, one2one = preds["one2many"], preds["one2one"]
         loss_one2many = self.one2many.loss(one2many, batch)
         loss_one2one = self.one2one.loss(one2one, batch)
-        return loss_one2many[0] * self.o2m + loss_one2one[0] * self.o2o, loss_one2one[1]
+        total = loss_one2many[0] * self.o2m + loss_one2one[0] * self.o2o
+        items = loss_one2one[1]
+        if self.dhcd_w:
+            distill = self.distill(one2many, one2one)
+            total = total + F.pad(distill.reshape(1) * self.dhcd_w, (1, 1))  # added to the cls slot of (box, cls, dfl)
+            items = {**items, "dhcd_loss": distill.detach()}
+        return total, items
+
+    def distill(self, one2many: dict[str, torch.Tensor], one2one: dict[str, torch.Tensor]) -> torch.Tensor:
+        """Match the one-to-one head's class posteriors to the one-to-many head's on the anchors the teacher fires on.
+
+        The NMS-free head is supervised by a single positive per object, so its scores stay under-confident and small
+        objects are dropped at deployment thresholds. The one-to-many head aggregates many positives per object, so its
+        posterior is a lower-variance target for the same anchors. The teacher is read under no_grad, so only the
+        student receives gradient and inference is unchanged.
+        """
+        student = one2one["scores"].permute(0, 2, 1)  # (b, a, nc)
+        with torch.no_grad():
+            teacher = one2many["scores"].detach().permute(0, 2, 1).sigmoid()
+            mask = teacher.amax(-1) > 0.1  # anchors the teacher believes carry an object
+        if not mask.any():
+            return student.sum() * 0
+        return F.binary_cross_entropy_with_logits(student[mask], teacher[mask])
 
     def update(self) -> None:
         """Update the weights for one-to-many and one-to-one losses based on the decay schedule."""
