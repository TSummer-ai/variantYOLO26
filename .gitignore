# 环境
.venv/
__pycache__/
*.py[cod]
.config/
.cache/
.pip-cache/
workdir/

# 数据（体积大，用 scripts/prepare_visdrone.sh 自行准备）
datasets/
*.zip

# 训练产物（只提交 results/ 里的 results.csv 和图表）
runs/
tb_server.log
*.log
!results/oracle_logs/*.log

# 权重
*.pt
# 只放行 weights/ 下的最终模型（注意：gitignore 的行尾注释无效，注释必须单独成行）
!weights/*.pt
*.onnx
*.engine
*.torchscript
